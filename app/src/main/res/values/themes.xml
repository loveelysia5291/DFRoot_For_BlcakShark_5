<resources>
    <!--
        Compose host. No platform ActionBar: MIUIX draws its own top app bar and
        Scaffold consumes the system-bar insets, so the window is edge-to-edge.
    -->
    <style name="Theme.DirtyFrag.Compose" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
