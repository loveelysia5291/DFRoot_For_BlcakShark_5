<?xml version="1.0" encoding="utf-8"?>
<!--
  DFRoot launcher foreground: M26-style fragmentation grenade.
  Conical shoulder, fuze + pull ring, safety lever down the right side and a
  knurled body (the "M·26 A2" text on the real thing is deliberately omitted).
  Neutral light fill so it reads on every Monet accent plate.
  Content stays inside the 72dp adaptive-icon safe zone (18..90).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

  <!-- pull ring -->
  <path
      android:strokeColor="#FFE9F0EB"
      android:strokeWidth="2.2"
      android:fillColor="#00000000"
      android:pathData="M67,19.8 A5.2,5.2 0 1 0 67,30.2 A5.2,5.2 0 1 0 67,19.8 Z"/>

  <!-- safety lever: across the top, then down the right side -->
  <path
      android:pathData="M58,30.5 L71,30.5 A7,7 0 0 1 78,37.5 L78,64.6 A4.2,4.2 0 0 1 69.6,64.6 L69.6,39.5 A2,2 0 0 0 67.6,37.5 L58,37.5 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="58" android:startY="30"
          android:endX="78" android:endY="66"
          android:startColor="#FFFDFEFD"
          android:endColor="#FFB9C8BE" />
    </aapt:attr>
  </path>
  <path
      android:strokeColor="#FF152219"
      android:strokeAlpha="0.30"
      android:strokeWidth="1.5"
      android:fillColor="#00000000"
      android:pathData="M58,30.5 L71,30.5 A7,7 0 0 1 78,37.5 L78,64.6 A4.2,4.2 0 0 1 69.6,64.6 L69.6,39.5 A2,2 0 0 0 67.6,37.5 L58,37.5 Z"/>

  <!-- fuze cap -->
  <path
      android:pathData="M49.8,30.8 h8.4 a2,2 0 0 1 2,2 v5.2 h-12.4 v-5.2 a2,2 0 0 1 2,-2 z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="48" android:startY="30"
          android:endX="60" android:endY="38"
          android:startColor="#FFF7FAF8"
          android:endColor="#FFC2CFC6" />
    </aapt:attr>
  </path>

  <!-- conical shoulder -->
  <path android:pathData="M45.6,38 L62.4,38 L60.2,47 L47.8,47 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="45" android:startY="38"
          android:endX="63" android:endY="47"
          android:startColor="#FFF4F8F5"
          android:endColor="#FFCBD8CF" />
    </aapt:attr>
  </path>
  <path
      android:strokeColor="#FF152219"
      android:strokeAlpha="0.22"
      android:strokeWidth="1.4"
      android:fillColor="#00000000"
      android:pathData="M45.6,38 L62.4,38 L60.2,47 L47.8,47 Z"/>

  <!-- body -->
  <path
      android:pathData="M54,46.6 C65.5,46.6 73.5,57 73.5,69 C73.5,81 66,88 54,88 C42,88 34.5,81 34.5,69 C34.5,57 42.5,46.6 54,46.6 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="36" android:startY="47"
          android:endX="73" android:endY="88"
          android:startColor="#FFFFFFFF"
          android:centerColor="#FFE4EBE6"
          android:endColor="#FFB5C4B9" />
    </aapt:attr>
  </path>

  <!-- knurling: four horizontal grooves -->
  <path android:strokeColor="#FF18271D" android:strokeAlpha="0.22" android:strokeWidth="1.6"
      android:strokeLineCap="round" android:fillColor="#00000000"
      android:pathData="M37.6,56 L70.4,56"/>
  <path android:strokeColor="#FF18271D" android:strokeAlpha="0.24" android:strokeWidth="1.6"
      android:strokeLineCap="round" android:fillColor="#00000000"
      android:pathData="M35.6,64 L72.4,64"/>
  <path android:strokeColor="#FF18271D" android:strokeAlpha="0.24" android:strokeWidth="1.6"
      android:strokeLineCap="round" android:fillColor="#00000000"
      android:pathData="M35.6,72 L72.4,72"/>
  <path android:strokeColor="#FF18271D" android:strokeAlpha="0.22" android:strokeWidth="1.6"
      android:strokeLineCap="round" android:fillColor="#00000000"
      android:pathData="M38.4,80 L69.6,80"/>

  <!-- knurling: three vertical grooves following the body curve -->
  <path android:strokeColor="#FF18271D" android:strokeAlpha="0.20" android:strokeWidth="1.4"
      android:fillColor="#00000000"
      android:pathData="M45.6,52 C44.3,63 44.3,75 45.6,85"/>
  <path android:strokeColor="#FF18271D" android:strokeAlpha="0.20" android:strokeWidth="1.4"
      android:fillColor="#00000000"
      android:pathData="M54,48 L54,87.4"/>
  <path android:strokeColor="#FF18271D" android:strokeAlpha="0.20" android:strokeWidth="1.4"
      android:fillColor="#00000000"
      android:pathData="M62.4,52 C63.7,63 63.7,75 62.4,85"/>

  <!-- body outline -->
  <path
      android:strokeColor="#FF152219"
      android:strokeAlpha="0.26"
      android:strokeWidth="1.6"
      android:fillColor="#00000000"
      android:pathData="M54,46.6 C65.5,46.6 73.5,57 73.5,69 C73.5,81 66,88 54,88 C42,88 34.5,81 34.5,69 C34.5,57 42.5,46.6 54,46.6 Z"/>
</vector>
