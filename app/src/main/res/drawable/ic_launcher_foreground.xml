<?xml version="1.0" encoding="utf-8"?>
<!--
  DFRoot launcher foreground: a clean, neutral grenade silhouette so it reads
  on every Monet accent plate (the plate colour is the per-palette background
  drawable, the grenade itself stays light).
  Everything sits inside the 72dp adaptive-icon safe zone (18..90).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

  <!-- pull ring above the fuze -->
  <path
      android:strokeColor="#FFEDF3EF"
      android:strokeWidth="2.4"
      android:fillColor="#00000000"
      android:pathData="M54,17.6 A5.2,5.2 0 1 0 54,28 A5.2,5.2 0 1 0 54,17.6 Z"/>
  <path
      android:fillColor="#FFEDF3EF"
      android:pathData="M52.9,27.2 h2.2 v3.4 h-2.2 z"/>

  <!-- fuze neck -->
  <path
      android:pathData="M49.2,30 h9.6 a3.2,3.2 0 0 1 3.2,3.2 v7.6 h-16 v-7.6 a3.2,3.2 0 0 1 3.2,-3.2 z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="46" android:startY="30"
          android:endX="62" android:endY="41"
          android:startColor="#FFF7FAF8"
          android:endColor="#FFC6D2C9" />
    </aapt:attr>
  </path>

  <!-- body -->
  <path
      android:pathData="M54,40 C64.6,40 72,51.8 72,64 C72,76.6 64.6,86 54,86 C43.4,86 36,76.6 36,64 C36,51.8 43.4,40 54,40 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="38" android:startY="41"
          android:endX="72" android:endY="86"
          android:startColor="#FFFFFFFF"
          android:centerColor="#FFE2EAE4"
          android:endColor="#FFB8C7BC" />
    </aapt:attr>
  </path>

  <!-- fragmentation grooves -->
  <path
      android:strokeColor="#FF1C2C22"
      android:strokeAlpha="0.20"
      android:strokeWidth="2.2"
      android:strokeLineCap="round"
      android:fillColor="#00000000"
      android:pathData="M38.4,58 L69.6,58"/>
  <path
      android:strokeColor="#FF1C2C22"
      android:strokeAlpha="0.22"
      android:strokeWidth="2.2"
      android:strokeLineCap="round"
      android:fillColor="#00000000"
      android:pathData="M36.8,67 L71.2,67"/>
  <path
      android:strokeColor="#FF1C2C22"
      android:strokeAlpha="0.20"
      android:strokeWidth="2.2"
      android:strokeLineCap="round"
      android:fillColor="#00000000"
      android:pathData="M39.8,76 L68.2,76"/>

  <!-- body outline keeps the silhouette crisp at 48dp -->
  <path
      android:strokeColor="#FF17251C"
      android:strokeAlpha="0.28"
      android:strokeWidth="1.8"
      android:fillColor="#00000000"
      android:pathData="M54,40 C64.6,40 72,51.8 72,64 C72,76.6 64.6,86 54,86 C43.4,86 36,76.6 36,64 C36,51.8 43.4,40 54,40 Z"/>

  <!-- safety lever (spoon) -->
  <path
      android:pathData="M60,26.6 L72,26.6 A9,9 0 0 1 81,35.6 L81,53.6 A2.2,2.2 0 0 1 76.6,53.6 L76.6,35.8 A2.6,2.6 0 0 0 74,33.2 L60,33.2 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="60" android:startY="26"
          android:endX="81" android:endY="54"
          android:startColor="#FFFDFEFD"
          android:endColor="#FFBFCEC4" />
    </aapt:attr>
  </path>
  <path
      android:strokeColor="#FF17251C"
      android:strokeAlpha="0.30"
      android:strokeWidth="1.6"
      android:fillColor="#00000000"
      android:pathData="M60,26.6 L72,26.6 A9,9 0 0 1 81,35.6 L81,53.6 A2.2,2.2 0 0 1 76.6,53.6 L76.6,35.8 A2.6,2.6 0 0 0 74,33.2 L60,33.2 Z"/>
</vector>
